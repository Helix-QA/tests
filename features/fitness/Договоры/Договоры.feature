			ВызватьИсключение "В тексте договора не найден комментарий законного представителя: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден комментарий законного представителя: " + Ожидаемое);

		// ===== Клиент: ФИО по отдельности =====
		Значение = Клиент.Фамилия;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустая фамилия клиента";
		КонецЕсли;
		Ожидаемое = "Фамилия: " + Значение;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдена фамилия клиента: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдена фамилия клиента: " + Ожидаемое);

		Значение = Клиент.Имя;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустое имя клиента";
		КонецЕсли;
		Ожидаемое = "Имя: " + Значение;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено имя клиента: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено имя клиента: " + Ожидаемое);

		// Пока в бланке у представителя стоит {ОтчествоКонтрагента}, отчество клиента выводится дважды,
		// поэтому эта проверка может пройти по строке представителя.
		Значение = Клиент.Отчество;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустое отчество клиента";
		КонецЕсли;
		Ожидаемое = "Отчество: " + Значение;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено отчество клиента: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено отчество клиента: " + Ожидаемое);

		// ===== Законный представитель: фамилия и имя по отдельности =====
		Значение = Представитель.Фамилия;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустая фамилия законного представителя";
		КонецЕсли;
		Ожидаемое = "Фамилия: " + Значение;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдена фамилия законного представителя: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдена фамилия законного представителя: " + Ожидаемое);

		Значение = Представитель.Имя;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустое имя законного представителя";
		КонецЕсли;
		Ожидаемое = "Имя: " + Значение;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено имя законного представителя: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено имя законного представителя: " + Ожидаемое);

		// ===== Клиент: адрес, автомобиль, карты =====
		Строки = Клиент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.АдресКлиента));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у клиента нет адреса";
		КонецЕсли;
		Ожидаемое = "Адрес: " + Строки[Строки.ВГраница()].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден адрес клиента: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден адрес клиента: " + Ожидаемое);

		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Автомобили.Ссылка КАК Ссылка ИЗ Справочник.Автомобили КАК Автомобили ГДЕ Автомобили.Владелец = &Владелец И НЕ Автомобили.ПометкаУдаления");
		Запрос.УстановитьПараметр("Владелец", Клиент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ВызватьИсключение "Не подготовлены данные: у клиента нет автомобиля";
		КонецЕсли;
		Автомобиль = Выборка.Ссылка;
		Ожидаемое = "Марка автомобиля: " + Автомобиль.Наименование;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдена марка автомобиля: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдена марка автомобиля: " + Ожидаемое);
		Если Не ЗначениеЗаполнено(Автомобиль.Код) Тогда
			ВызватьИсключение "Не подготовлены данные: у автомобиля клиента нет номера";
		КонецЕсли;
		Ожидаемое = "Номер автомобиля: " + Автомобиль.Код;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден номер автомобиля: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден номер автомобиля: " + Ожидаемое);

		Запрос = Новый Запрос("ВЫБРАТЬ Карты.Ссылка КАК Ссылка ИЗ Справочник.Карты КАК Карты ГДЕ Карты.ВладелецКарты = &Владелец И НЕ Карты.ПометкаУдаления И НЕ Карты.Заблокирована УПОРЯДОЧИТЬ ПО Карты.ДатаОткрытия");
		Запрос.УстановитьПараметр("Владелец", Клиент);
		Выборка = Запрос.Выполнить().Выбрать();
		СписокКарт = "";
		Разделитель = "";
		Пока Выборка.Следующий() Цикл
			Карта = Выборка.Ссылка;
			Если Карта.ТипКода <> Перечисления.ВидыКарт.Электронная И ЗначениеЗаполнено(Карта.ВнутреннийКодКарты) Тогда
				КодКарты = Строка(Карта.ВнутреннийКодКарты);
			Иначе
				КодКарты = Строка(Карта.КодКарты);
			КонецЕсли;
			СписокКарт = СписокКарт + Разделитель + КодКарты;
			Разделитель = ", ";
		КонецЦикла;
		Если СписокКарт = "" Тогда
			ВызватьИсключение "Не подготовлены данные: у клиента нет карт";
		КонецЕсли;
		Ожидаемое = СтрЗаменить("Карты клиента: " + СписокКарт, Символ(160), " ");
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдены карты клиента: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдены карты клиента: " + Ожидаемое);

		// ===== Организация: ИНН, банк, адреса, факс =====
		Значение = Договор.Организация.ИНН;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			ВызватьИсключение "Не подготовлены данные: пустой ИНН организации";
		КонецЕсли;
		Ожидаемое = Значение + ",";
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден ИНН организации: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден ИНН организации: " + Ожидаемое);

		Счет = Договор.Организация.БанковскийСчетПоУмолчанию;
		Если Не ЗначениеЗаполнено(Счет) Тогда
			ВызватьИсключение "Не подготовлены данные: у организации нет банковского счета по умолчанию";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Счет.Банк.Наименование) Или Не ЗначениеЗаполнено(Счет.Банк.Код) Или Не ЗначениеЗаполнено(Счет.НомерСчета) Тогда
			ВызватьИсключение "Не подготовлены данные: у банковского счета организации не заполнены банк, БИК или номер счета";
		КонецЕсли;
		Ожидаемое = Счет.Банк.Наименование + ",";
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден банк организации: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден банк организации: " + Ожидаемое);
		Ожидаемое = Счет.Банк.Код + ",";
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден БИК банка организации: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден БИК банка организации: " + Ожидаемое);
		// Корр. счет не проверяем: у банка в тестовой базе он пустой.
		Ожидаемое = Счет.НомерСчета + ".";
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден расчетный счет организации: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден расчетный счет организации: " + Ожидаемое);

		Строки = Договор.Организация.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у организации нет почтового адреса";
		КонецЕсли;
		Ожидаемое = "Почтовый адрес: " + Строки[Строки.ВГраница()].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено: " + Ожидаемое);

		Строки = Договор.Организация.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у организации нет фактического адреса";
		КонецЕсли;
		Ожидаемое = "Фактический адрес: " + Строки[Строки.ВГраница()].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено: " + Ожидаемое);

		Строки = Договор.Организация.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у организации нет юридического адреса";
		КонецЕсли;
		Ожидаемое = "Юридический адрес: " + Строки[Строки.ВГраница()].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено: " + Ожидаемое);

		Строки = Договор.Организация.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ФаксОрганизации));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у организации нет факса";
		КонецЕсли;
		Ожидаемое = "Факс: " + Строки[Строки.ВГраница()].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найдено: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найдено: " + Ожидаемое);

		// ===== Структурная единица: адрес и телефон (программа берёт первую строку) =====
		Строки = Договор.СтруктурнаяЕдиница.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ФактАдресСтруктурнойЕдиницы));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у СЕ нет адреса";
		КонецЕсли;
		Ожидаемое = "Адрес: " + Строки[0].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден адрес СЕ: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден адрес СЕ: " + Ожидаемое);


		Строки = Договор.СтруктурнаяЕдиница.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСтруктурнойЕдиницы));
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у СЕ нет телефона";
		КонецЕсли;
		Ожидаемое = "Телефон: " + Строки[0].Представление;
		Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
			ВызватьИсключение "В тексте договора не найден телефон СЕ: " + Ожидаемое;
		КонецЕсли;
		Сообщить("Найден телефон СЕ: " + Ожидаемое);

		// ===== Удостоверение личности клиента (как в программе: документ-УЛ, иначе основной) =====
		Запрос = Новый Запрос("ВЫБРАТЬ Д.Серия КАК Серия, Д.Номер КАК Номер, Д.ДатаВыдачи КАК ДатаВыдачи, Д.СрокДействия КАК СрокДействия, Д.КемВыдан КАК КемВыдан, Д.КодПодразделения КАК КодПодразделения, Д.ВидДокумента.Представление КАК ВидДокумента, Д.Основной КАК Основной, Д.ЯвляетсяДокументомУдостоверяющимЛичность КАК ЯвляетсяУЛ ИЗ РегистрСведений.ДокументыФизическихЛиц КАК Д ГДЕ Д.Физлицо = &Физлицо");
		Запрос.УстановитьПараметр("Физлицо", Клиент);
		Таблица = Запрос.Выполнить().Выгрузить();
		Строки = Таблица.НайтиСтроки(Новый Структура("ЯвляетсяУЛ", Истина));
		Если Строки.Количество() = 0 Тогда
			Строки = Таблица.НайтиСтроки(Новый Структура("Основной", Истина));
		КонецЕсли;
		Если Строки.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у клиента нет удостоверения личности";
		КонецЕсли;
		Док = Строки[0];
		Если Не ЗначениеЗаполнено(Док.Серия) Или Не ЗначениеЗаполнено(Док.Номер) Или Не ЗначениеЗаполнено(Док.ДатаВыдачи)
			Или Не ЗначениеЗаполнено(Док.СрокДействия) Или Не ЗначениеЗаполнено(Док.КемВыдан) Или Не ЗначениеЗаполнено(Док.КодПодразделения) Тогда
			ВызватьИсключение "Не подготовлены данные: в удостоверении личности клиента заполнены не все поля";
		КонецЕсли;
		Проверки = Новый Массив;
		Проверки.Добавить(Док.ВидДокумента + ",");
		Проверки.Добавить(Формат(Док.ДатаВыдачи, "ДФ='дд ММММ гггг'") + ",");
		Проверки.Добавить(Док.КемВыдан + ",");
		Проверки.Добавить(Док.КодПодразделения + ",");
		Проверки.Добавить(Док.Номер + ",");
		Проверки.Добавить(Док.Серия + ",");
		Проверки.Добавить(Формат(Док.СрокДействия, "ДФ='дд ММММ гггг'"));
		Для Каждого Ожидаемое Из Проверки Цикл
			Если СтрНайти(Текст, Ожидаемое) = 0 Тогда
				ВызватьИсключение "В тексте договора не найдено удостоверение личности клиента: " + Ожидаемое;
			КонецЕсли;
			Сообщить("Найдено удостоверение личности клиента: " + Ожидаемое);
		КонецЦикла;

		// ===== Паспортные данные законного представителя (как в программе: основной документ) =====
		Запрос = Новый Запрос("ВЫБРАТЬ Д.Серия КАК Серия, Д.Номер КАК Номер, Д.ДатаВыдачи КАК ДатаВыдачи, Д.СрокДействия КАК СрокДействия, Д.КемВыдан КАК КемВыдан, Д.КодПодразделения КАК КодПодразделения ИЗ РегистрСведений.ДокументыФизическихЛиц КАК Д ГДЕ Д.Физлицо = &Физлицо И Д.Основной");
		Запрос.УстановитьПараметр("Физлицо", Представитель);
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 0 Тогда
			ВызватьИсключение "Не подготовлены данные: у законного представителя нет основного документа";
		КонецЕсли;
		Док = Таблица[0];
		Если Не ЗначениеЗаполнено(Док.Серия) Или Не ЗначениеЗаполнено(Док.Номер) Или Не ЗначениеЗаполнено(Док.ДатаВыдачи)
			Или Не ЗначениеЗаполнено(Док.СрокДействия) Или Не ЗначениеЗаполнено(Док.КемВыдан) Или Не ЗначениеЗаполнено(Док.КодПодразделения) Тогда
			ВызватьИсключение "Не подготовлены данные: в документе законного представителя заполнены не все поля";
		КонецЕсли;
		Проверки = Новый Массив;
